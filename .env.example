# LocalPilot environment reference. Copy to .env and fill in what you need.
# Never commit .env. Every secret below is read only on the server; none is
# ever sent to the browser.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the app. Used for OAuth redirects, email links, review pages.
APP_URL=http://localhost:3000
APP_NAME=LocalPilot
# Comma-separated extra hostnames that serve the app itself (white-label app
# domains). Any other host is treated as a customer website domain.
APP_HOSTS=
DATABASE_URL=postgres://localpilot:localpilot@localhost:5432/localpilot
# Max connections per process (default 10).
DB_POOL_MAX=

# 32 random bytes, base64. Encrypts OAuth tokens (AES-256-GCM) and signs media
# links. REQUIRED in production; the app refuses to sign links without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Bearer secret for POST /api/cron (scheduler tick when you do not run the worker).
# The endpoint returns 503 while this is unset.
CRON_SECRET=

# Where uploaded media and rendered videos are stored on disk.
STORAGE_DIR=./storage

# When true, providers without credentials run clearly labeled demo adapters.
# Demo results are stored with is_demo=true, shown with a Demo badge, and never
# appear on public websites. When false, unconfigured features are blocked.
DEMO_MODE=false

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_QUEUES=default,media

# --- AI writing (Anthropic) -------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Google Business Profile and YouTube (one Google Cloud OAuth client) ----
# Redirect URIs: ${APP_URL}/api/oauth/google/callback and ${APP_URL}/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook Pages and Instagram (one Meta app) -----------------------------
# Redirect URIs: ${APP_URL}/api/oauth/facebook/callback and ${APP_URL}/api/oauth/instagram/callback
META_APP_ID=
META_APP_SECRET=

# --- LinkedIn Pages ---------------------------------------------------------
# Redirect URI: ${APP_URL}/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- CompanyCam -------------------------------------------------------------
# Redirect URI: ${APP_URL}/api/oauth/companycam/callback
COMPANYCAM_CLIENT_ID=
COMPANYCAM_CLIENT_SECRET=

# --- Ranking grid and keyword volumes (DataForSEO) --------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- AI visibility audits (each provider is optional) -----------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
AI_VISIBILITY_OPENAI_MODEL=gpt-4.1
AI_VISIBILITY_GEMINI_MODEL=gemini-2.5-flash
AI_VISIBILITY_PERPLEXITY_MODEL=sonar

# --- Video narration (ElevenLabs) -------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Email ------------------------------------------------------------------
# smtp(s)://user:pass@host:port. Without it, emails are recorded but not sent.
SMTP_URL=
EMAIL_FROM=LocalPilot <no-reply@localhost>

# --- Seeding (npm run db:seed) ----------------------------------------------
SEED_EMAIL=demo@localpilot.test
# Leave blank to generate one; it is printed once.
SEED_PASSWORD=
# The seed refuses to run when NODE_ENV=production unless this is true.
SEED_ALLOW_PRODUCTION=false

# --- Tests ------------------------------------------------------------------
# Integration and e2e tests truncate this database. The reset refuses any URL
# that does not contain "localpilot_test".
TEST_DATABASE_URL=postgres://localpilot:localpilot@localhost:5432/localpilot_test
# Optional: use a preinstalled Chromium for Playwright.
PLAYWRIGHT_CHROMIUM_PATH=
